# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local dev (outside Docker): use localhost
# Inside Docker (docker-compose): use the service hostname "mongodb"
MONGODB_URI=mongodb://arogya:arogya_secret@localhost:27017/arogya_notifications?authSource=admin

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────────
# Leave blank in development — service will log SMS bodies to console instead.
# TWILIO_ACCOUNT_SID=AC90caaecf7689758c00748e7e8eda6a68
# TWILIO_AUTH_TOKEN=bbdf1b08d3ce6bfa8e04c8220fe1a06c
# TWILIO_FROM_NUMBER=

# ─── Gmail SMTP (takes priority over SendGrid when set) ───────────────────────
# Use your Gmail address + a 16-char App Password (NOT your real password).
# To generate: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# ─── SendGrid (Email) — fallback when SMTP_USER/PASS not set ─────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=you@example.com
SENDGRID_FROM_NAME=Arogya Health

# ─── Internal service URLs ────────────────────────────────────────────────────
PATIENT_SERVICE_URL=http://localhost:8082
DOCTOR_SERVICE_URL=http://localhost:8083
AUTH_SERVICE_URL=http://localhost:8081

# ─── Retry config ─────────────────────────────────────────────────────────────
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000
