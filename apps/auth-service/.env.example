# Auth Service Environment Variables
# Copy this file to .env and fill in real values — never commit .env itself

NODE_ENV=development
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/arogya_auth

# JWT Access Token (short-lived: 15m)
JWT_SECRET=replace_with_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=15m

# JWT Refresh Token (long-lived: 7d, kept in httpOnly cookie)
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt work factor (12 = ~250ms hash time, good balance of security vs speed)
BCRYPT_ROUNDS=12